{
	"name": "elm-vscode",
	"displayName": "Elm VSCode",
	"type": "module",
	"description": "A basic language extension for the Elm programming language",
	"publisher": "asgr-dk",
	"repository": {
		"url": "https://github.com/asgr-dk/elm-vscode"
	},
	"icon": "./logo.jpg",
	"version": "0.5.0",
	"activationEvents": [
		"workspaceContains:elm.json"
	],
	"engines": {
		"vscode": "^1.140.0"
	},
	"main": "source/Main.ts",
	"contributes": {
		"configurationDefaults": {
			"[elm]": {
				"editor.tabSize": 4,
				"editor.formatOnSave": true,
				"editor.wordBasedSuggestions": "off"
			}
		},
		"configuration": {
			"title": "Elm VSCode",
			"properties": {
				"compilerPath": {
					"type": "string",
					"default": "elm",
					"description": "The path to the elm compiler. Default value is \"elm\"."
				},
				"formatterPath": {
					"type": "string",
					"default": "elm-format",
					"description": "The path to the elm formatter. Default value is \"elm-format\"."
				}
			}
		},
		"languages": [
			{
				"id": "elm",
				"aliases": [
					"Elm",
					"elm"
				],
				"extensions": [
					".elm"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "elm",
				"scopeName": "source.elm",
				"path": "./elm.tmLanguage.json"
			}
		]
	},
	"categories": [
		"Programming Languages"
	],
	"scripts": {},
	"devDependencies": {
		"@types/node": "26.6.5",
		"@types/vscode": "1.140.0",
		"@vscode/vsce": "4.0.0"
	}
}