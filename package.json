{
	"name": "elm-vscode",
	"displayName": "Elm VSCode",
	"description": "A basic language extension for the Elm programming language",
	"publisher": "asgr-dk",
	"repository": "https://github.com/asgr-dk/elm-vscode",
	"version": "0.1.0",
	"activationEvents": [
		"workspaceContains:**/elm.json"
	],
	"engines": {
		"vscode": "^1.140.0"
	},
	"main": "source/Main.ts",
	"contributes": {
		"configurationDefaults": {
			"[elm]": {
				"editor.tabSize": 4,
				"editor.formatOnSave": true,
				"editor.wordBasedSuggestions": "off"
			}
		},
		"languages": [
			{
				"id": "elm",
				"aliases": [
					"Elm",
					"elm"
				],
				"extensions": [
					".elm"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "elm",
				"scopeName": "source.elm",
				"path": "./elm.tmLanguage.json"
			}
		]
	},
	"categories": [
		"Programming Languages"
	],
	"scripts": {},
	"devDependencies": {
		"@types/node": "26.6.5",
		"@types/vscode": "1.140.0"
	}
}